<configuration>

    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>utf8</charset>
            <pattern>%green(%d{yyyy-MM-dd HH:mm:ss.SSS XXX}) | %-10.10thread | %highlight(%-5level)| %cyan(%-35.35logger{15}) | %m%n</pattern>
        </encoder>
    </appender>

<!--    <logger additivity="false" level="debug" name="dima.d.coder.restapp">-->
<!--        <appender-ref ref="Console"/>-->
<!--    </logger>-->

    <root level="info">
        <appender-ref ref="Console" />
    </root>

</configuration>